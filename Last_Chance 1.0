<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Son Sığınak – Zombi Hayatta Kalma</title>
<style>
  html,body{margin:0;height:100%;background:#0d1210;color:#d8e2d0;font-family:Georgia,"Times New Roman",serif;overflow:hidden}
  canvas{display:block;margin:0 auto;background:#1a2119;cursor:crosshair;max-width:100%}
  #ov{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(8,12,10,.88);text-align:center;padding:20px}
  #ov h1{font-size:44px;margin:0 0 8px;color:#b8d86b;letter-spacing:1px}
  #ov p{max-width:460px;line-height:1.55;margin:6px 0}
  button{margin-top:18px;font:inherit;font-size:20px;padding:10px 28px;background:#b8d86b;color:#0d1210;border:0;border-radius:4px;cursor:pointer}
  button:focus-visible{outline:3px solid #fff}
  #shop{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;background:rgba(8,12,10,.95);padding:18px 14px;overflow:auto;z-index:5;box-sizing:border-box}
  .sh-ust{display:flex;align-items:center;justify-content:space-between;gap:18px;width:min(940px,96vw)}
  #shop h2{margin:0;color:#b8d86b;font-size:30px}
  .sh-para{background:#2a2610;color:#e6c75a;border:1px solid #6d5f20;border-radius:20px;padding:4px 16px;font-size:22px}
  .sh-alt{width:min(940px,96vw);color:#9fb092;margin:6px 0 10px}
  .sh-tab{display:flex;gap:6px;flex-wrap:wrap;width:min(940px,96vw);margin-bottom:12px}
  #shop .sh-tab button{background:#18211a;color:#d8e2d0;border:1px solid #2f3d2f;border-radius:16px;padding:6px 16px;font-size:15px}
  #shop .sh-tab button.on{background:#b8d86b;color:#0d1210}
  .sh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;width:min(940px,96vw)}
  .sh-kart{background:#151d17;border:1px solid #26322a;border-top:3px solid var(--renk);border-radius:6px;padding:12px;display:flex;flex-direction:column;gap:6px}
  .sh-kart.eld{box-shadow:0 0 0 2px var(--renk) inset;background:#1b261d}
  .sh-kart.soluk{opacity:.55}
  .sh-bas{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
  .sh-bas b{font-size:18px}
  .sh-bas em{font-size:12px;color:var(--renk);font-style:normal}
  .sh-kart p{margin:0;color:#9fb092;font-size:13px;min-height:34px;line-height:1.3}
  .sh-bar{display:flex;align-items:center;gap:8px;font-size:12px;color:#9fb092}
  .sh-bar span{width:44px}
  .sh-bar i{flex:1;height:6px;background:#0d1210;border-radius:3px;overflow:hidden;display:block}
  .sh-bar i b{display:block;height:100%}
  .sh-alt2{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:6px}
  .sh-fiyat{color:#e6c75a;font-size:18px}
  .sh-el{color:var(--renk);font-size:14px}
  .sh-kart small{color:#7d8f74}
  #shop button{margin:0;font-size:15px;padding:6px 14px;white-space:nowrap}
  #shop button:disabled{background:#4a5446;color:#889;cursor:not-allowed}
  #shop .sh-kapat{margin-top:16px;padding:8px 24px;font-size:17px}
  #zor{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:14px}
  #zor button{margin:0;font-size:16px;padding:8px 18px;background:#18211a;color:#d8e2d0;border:1px solid #3a4a3a}
  #zor button.on{background:#b8d86b;color:#0d1210;border-color:#b8d86b}
  #zacik{color:#9fb092;margin:8px 0 0;min-height:22px}
  #dk,#kb{position:fixed;top:10px;right:10px;margin:0;font-size:15px;padding:6px 14px;display:none;z-index:2}
  #kb{right:130px}
  #kon{position:fixed;left:0;right:0;bottom:0;display:none;background:rgba(5,8,6,.93);padding:10px 14px;z-index:6;font-family:Consolas,monospace;font-size:15px;border-top:2px solid #b8d86b}
  #konlog div{margin:2px 0}
  #konin{width:100%;box-sizing:border-box;margin-top:6px;background:#0d1210;color:#d8e2d0;border:1px solid #3a4a3a;padding:8px;font:inherit}
</style>
</head>
<body>
<canvas id="c" width="900" height="600"></canvas>
<button id="dk">Dükkân (B)</button>
<button id="kb">Komut (T)</button>
<div id="shop"></div>
<div id="kon"><div id="konlog"></div><input id="konin" autocomplete="off" spellcheck="false" placeholder="Komut yaz, Enter ile çalıştır, Esc ile kapat"></div>
<div id="ov">
  <h1>Son Sığınak</h1>
  <p>Şehir düştü. Elinde bir tabanca ve sınırlı cephane var. Dalgalar halinde gelen zombilere karşı hayatta kal.</p>
  <p><b>WASD / Oklar</b>: hareket &nbsp; <b>Fare</b>: nişan &nbsp; <b>Tıkla</b>: ateş<br><b>R</b>: şarjör değiştir &nbsp; <b>Shift</b>: koş<br><b>B</b>: silah dükkânı &nbsp; <b>1-0, Q/E, tekerlek</b>: silah seç &nbsp; <b>T</b>: komut konsolu<br>Zombileri öldürerek para kazan, silah satın al.</p>
  <p id="sonuc"></p>
  <div id="zor"></div><p id="zacik"></p>
  <button id="btn">Başla</button>
</div>
<script>
const cv=document.getElementById('c'),cx=cv.getContext('2d');
const W=cv.width,H=cv.height;
const ov=document.getElementById('ov'),btn=document.getElementById('btn'),sonuc=document.getElementById('sonuc');
const ZORLUK={
 kolay:{ad:'Kolay',acik:'Yavaş ve zayıf zombiler, bol para. $50 ile başlarsın.',hiz:.85,can:.8,hasar:.6,sayi:.75,para:1.25,drop:.4,bas:50},
 normal:{ad:'Normal',acik:'Dengeli bir hayatta kalma deneyimi.',hiz:1,can:1,hasar:1,sayi:1,para:1,drop:.3,bas:0},
 zor:{ad:'Zor',acik:'Daha hızlı, daha sert ve daha kalabalık. Para daha az.',hiz:1.1,can:1.4,hasar:1.4,sayi:1.3,para:.8,drop:.25,bas:0},
 kabus:{ad:'Kâbus',acik:'Çok sayıda, çok dayanıklı zombi. Para ve cephane kıt.',hiz:1.25,can:2,hasar:2,sayi:1.7,para:.6,drop:.18,bas:0}
};
let Z=ZORLUK.normal;
const WEAPONS=[
 {ad:'Tabanca',fiyat:0,mag:12,cd:.18,pel:1,spr:.06,dmg:1,hiz:700,rel:1.3,ses:180,ack:'Dengeli başlangıç silahı.'},
 {ad:'Balta',fiyat:60,melee:true,mag:0,cd:.45,pel:0,spr:0,dmg:3,hiz:0,rel:0,menzil:58,arc:1.9,ses:80,ack:'Geniş yaylı darbe, cephane harcamaz.'},
 {ad:'Revolver',fiyat:90,mag:6,cd:.42,pel:1,spr:.03,dmg:3,hiz:900,rel:1.9,ses:130,ack:'Yavaş ama sert vuran altıpatlar.'},
 {ad:'Hafif Makineli',fiyat:130,mag:30,cd:.08,pel:1,spr:.14,dmg:1,hiz:760,rel:1.6,ses:210,ack:'Hızlı ateş, dağınık nişan.'},
 {ad:'Testere',fiyat:220,melee:true,mag:0,cd:.12,pel:0,spr:0,dmg:1,hiz:0,rel:0,menzil:46,arc:1.3,ses:60,ack:'Çok hızlı doğrar, kısa menzil.'},
 {ad:'Pompalı',fiyat:280,mag:6,cd:.75,pel:7,spr:.38,dmg:1,hiz:650,rel:2.2,omur:.35,ses:90,ack:'Yakında yıkıcı, 7 saçma atar.'},
 {ad:'Tüfek',fiyat:400,mag:30,cd:.1,pel:1,spr:.05,dmg:2,hiz:950,rel:1.9,ses:150,ack:'Hızlı, isabetli ve güçlü.'},
 {ad:'Keskin Nişancı',fiyat:550,mag:5,cd:.9,pel:1,spr:.01,dmg:4,hiz:1300,rel:2.0,delici:true,ses:140,ack:'Zombileri delip arkadakini de vurur.'},
 {ad:'Alev Atar',fiyat:750,mag:100,cd:.04,pel:1,spr:.3,dmg:.5,hiz:380,rel:2.6,omur:.45,delici:true,renk:'#ff8a2b',boy:4,ses:50,ack:'Kalabalıkları yakar, kısa menzil.'},
 {ad:'Ağır Makineli',fiyat:900,mag:60,cd:.065,pel:1,spr:.1,dmg:2,hiz:820,rel:2.8,ses:120,ack:'Büyük şarjör, yüksek hasar.'},
 {ad:'Roketatar',fiyat:1500,mag:4,cd:1.1,pel:1,spr:.01,dmg:0,hiz:520,rel:2.6,patla:95,patdmg:8,renk:'#ff5a3a',boy:5,ses:70,ack:'Çarptığı yerde alan hasarlı patlama.'}
];
let keys={},mouse={x:W/2,y:H/2,down:false};
let p,zs,bs,items,parts,wave,score,kills,running,lastT,spawnLeft,spawnTimer,waveBreak,shake,floats,rings,shopOpen=false,konOpen=false,flash=0;

function reset(){
  p={x:W/2,y:H/2,r:14,hp:100,stam:100,money:Z.bas,g:0,reload:0,cd:0,ang:0};
  p.guns=WEAPONS.map((w,i)=>({own:i==0,ammo:i==0?w.mag:0,res:i==0?w.mag*3:0}));
  zs=[];bs=[];items=[];parts=[];floats=[];rings=[];flash=0;cheats.god=cheats.inf=cheats.speed=false;wave=0;score=0;kills=0;shake=0;
  waveBreak=2;spawnLeft=0;spawnTimer=0;
}
function nextWave(){
  wave++;spawnLeft=Math.round((5+wave*4)*Z.sayi);spawnTimer=0;
}
function spawnZ(){
  const side=Math.floor(Math.random()*4);
  let x,y;
  if(side==0){x=Math.random()*W;y=-20}
  else if(side==1){x=W+20;y=Math.random()*H}
  else if(side==2){x=Math.random()*W;y=H+20}
  else{x=-20;y=Math.random()*H}
  const big=Math.random()<Math.min(.04*wave,.25);
  const fast=!big&&Math.random()<Math.min(.06*wave,.3);
  const hp0=(big?6:2)*Z.can;
  zs.push({x,y,r:big?22:13,hp:hp0,max:hp0,sp:(big?42:fast?95:55+Math.random()*20)*Z.hiz,dmg:(big?18:9)*Z.hasar,val:Math.max(1,Math.round((big?40:fast?15:10)*Z.para)),big,fast,hit:0});
}
function burst(x,y,n,col){
  for(let i=0;i<n;i++){const a=Math.random()*6.28,s=40+Math.random()*140;
    parts.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:.4+Math.random()*.4,col});}
}
function shoot(){
  const w=cw(),s=cs();
  if(p.reload>0||p.cd>0)return;
  if(w.melee){vur(w);return}
  if(s.ammo<=0){startReload();return}
  if(!cheats.inf)s.ammo--;p.cd=w.cd;shake=w.pel>1?6:3;
  for(let i=0;i<w.pel;i++){
    const a=p.ang+(Math.random()-.5)*w.spr;
    bs.push({x:p.x+Math.cos(p.ang)*22,y:p.y+Math.sin(p.ang)*22,vx:Math.cos(a)*w.hiz,vy:Math.sin(a)*w.hiz,life:w.omur||.9,dmg:w.dmg,del:!!w.delici,vurdu:[],renk:w.renk,boy:w.boy||2.5,patla:w.patla,patdmg:w.patdmg});
  }
  beep(w.ses,.05,'square',.04);
}
function startReload(){
  const w=cw(),s=cs();
  if(w.melee||p.reload>0||s.ammo==w.mag||s.res<=0)return;
  p.reload=w.rel;beep(110,.1,'sawtooth',.04);
}
let ac=null;
function beep(f,d,t,v){
  try{ac=ac||new (window.AudioContext||window.webkitAudioContext)();
  const o=ac.createOscillator(),g=ac.createGain();
  o.type=t;o.frequency.value=f;g.gain.value=v;
  o.connect(g);g.connect(ac.destination);
  g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+d);
  o.start();o.stop(ac.currentTime+d);}catch(e){}
}
function update(dt){
  // hareket
  let dx=(keys['d']||keys['arrowright']?1:0)-(keys['a']||keys['arrowleft']?1:0);
  let dy=(keys['s']||keys['arrowdown']?1:0)-(keys['w']||keys['arrowup']?1:0);
  const len=Math.hypot(dx,dy)||1;
  const run=keys['shift']&&p.stam>0&&(dx||dy);
  const sp=(run?210:130)*(cheats.speed?1.8:1);
  p.stam=Math.max(0,Math.min(100,p.stam+(run?-30:18)*dt));
  p.x=Math.max(p.r,Math.min(W-p.r,p.x+dx/len*sp*dt));
  p.y=Math.max(p.r,Math.min(H-p.r,p.y+dy/len*sp*dt));
  p.ang=Math.atan2(mouse.y-p.y,mouse.x-p.x);
  p.cd-=dt;p.swing=Math.max(0,(p.swing||0)-dt);flash=Math.max(0,flash-dt*.8);
  if(p.reload>0){p.reload-=dt;
    if(p.reload<=0){const w=cw(),g=cs(),need=w.mag-g.ammo,take=Math.min(need,g.res);g.ammo+=take;g.res-=take;}}
  if(mouse.down)shoot();
  // dalga yönetimi
  if(spawnLeft<=0&&zs.length==0){
    waveBreak-=dt;
    if(waveBreak<=0){nextWave();waveBreak=3}
  }
  if(spawnLeft>0){
    spawnTimer-=dt;
    if(spawnTimer<=0){spawnZ();spawnLeft--;spawnTimer=Math.max(.35,1.2-wave*.07)}
  }
  // mermiler
  for(const b of bs){b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;
    for(const z of zs){
      if(z.hp>0&&!b.vurdu.includes(z)&&Math.hypot(z.x-b.x,z.y-b.y)<z.r){
        if(b.patla){b.life=0;patlat(b);break}
        z.hp-=b.dmg;z.hit=.1;b.vurdu.push(z);if(!b.del)b.life=0;burst(b.x,b.y,5,'#7a1f1f');
        z.x+=b.vx*.02;z.y+=b.vy*.02;
        if(z.hp<=0){kills++;score+=z.big?50:10;kazan(z);burst(z.x,z.y,14,'#5a1010');
          if(Math.random()<Z.drop)items.push({x:z.x,y:z.y,t:Math.random()<.5?'ammo':'med',life:12});}
        if(!b.del)break;
      }}}
  bs=bs.filter(b=>b.life>0&&b.x>-10&&b.x<W+10&&b.y>-10&&b.y<H+10);
  zs=zs.filter(z=>z.hp>0);
  // zombiler
  for(const z of zs){
    const a=Math.atan2(p.y-z.y,p.x-z.x);
    z.x+=Math.cos(a)*z.sp*dt;z.y+=Math.sin(a)*z.sp*dt;z.a=a;z.hit-=dt;
    // zombiler birbirini itsin
    for(const o of zs){if(o!==z){const d=Math.hypot(z.x-o.x,z.y-o.y);
      if(d<z.r+o.r&&d>0){z.x+=(z.x-o.x)/d*20*dt;z.y+=(z.y-o.y)/d*20*dt}}}
    if(Math.hypot(p.x-z.x,p.y-z.y)<p.r+z.r){
      if(!cheats.god){p.hp-=z.dmg*dt*1.6;shake=Math.max(shake,2);flash=.25}
      if(!cheats.god&&Math.random()<.05)burst(p.x,p.y,3,'#a33');
    }
  }
  // eşyalar
  for(const it of items){it.life-=dt;
    if(Math.hypot(p.x-it.x,p.y-it.y)<p.r+10){
      if(it.t=='ammo')ammoVer();else p.hp=Math.min(100,p.hp+25);
      it.life=0;beep(520,.1,'sine',.05);}}
  items=items.filter(i=>i.life>0);
  for(const q of parts){q.x+=q.vx*dt;q.y+=q.vy*dt;q.life-=dt}
  parts=parts.filter(q=>q.life>0);
  for(const f of floats){f.y-=30*dt;f.life-=dt}
  floats=floats.filter(f=>f.life>0);
  for(const r of rings)r.life-=dt;
  rings=rings.filter(r=>r.life>0);
  shake=Math.max(0,shake-dt*20);
  if(p.hp<=0)bitti();
}
function draw(){
  cx.save();
  if(shake>0)cx.translate((Math.random()-.5)*shake,(Math.random()-.5)*shake);
  cx.fillStyle='#1a2119';cx.fillRect(0,0,W,H);
  // zemin izgarası
  cx.strokeStyle='rgba(255,255,255,.035)';cx.lineWidth=1;
  for(let x=0;x<W;x+=50){cx.beginPath();cx.moveTo(x,0);cx.lineTo(x,H);cx.stroke()}
  for(let y=0;y<H;y+=50){cx.beginPath();cx.moveTo(0,y);cx.lineTo(W,y);cx.stroke()}
  // Türk bayrağı: direğe bağlı, hafifçe dalgalanan kumaş
  cx.save();
  cx.lineCap='round';
  cx.strokeStyle='#777b70';cx.lineWidth=5;
  cx.beginPath();cx.moveTo(758,105);cx.lineTo(758,278);cx.stroke();
  cx.strokeStyle='#c5c9bb';cx.lineWidth=1.5;
  cx.beginPath();cx.moveTo(756,105);cx.lineTo(756,278);cx.stroke();

  const bayrakZamani=performance.now()/430;
  const bayrakGenislik=90, bayrakYukseklik=60;
  const dalga=(x)=>Math.sin(bayrakZamani-x*.075)*(x/bayrakGenislik)*5;
  const bayrakX=760, bayrakY=112;
  cx.beginPath();
  for(let x=0;x<=bayrakGenislik;x+=3){
    const y=bayrakY+dalga(x);
    if(x===0)cx.moveTo(bayrakX+x,y);else cx.lineTo(bayrakX+x,y);
  }
  for(let x=bayrakGenislik;x>=0;x-=3){
    cx.lineTo(bayrakX+x,bayrakY+bayrakYukseklik+dalga(x));
  }
  cx.closePath();
  cx.fillStyle='#d71920';cx.fill();
  cx.save();cx.clip();
  // Hilal ve yıldız da kumaşla birlikte hafifçe hareket eder.
  const hilalX=bayrakX+27, hilalY=bayrakY+30+dalga(27);
  cx.save();cx.translate(hilalX,hilalY);cx.rotate(Math.cos(bayrakZamani-27*.075)*.035);
  cx.fillStyle='#fff';cx.beginPath();cx.arc(0,0,19,0,Math.PI*2);cx.fill();
  cx.fillStyle='#d71920';cx.beginPath();cx.arc(11,0,15,0,Math.PI*2);cx.fill();
  cx.restore();
  const yildizX=bayrakX+58, yildizY=bayrakY+30+dalga(58);
  cx.save();cx.translate(yildizX,yildizY);cx.rotate(Math.cos(bayrakZamani-58*.075)*.035);
  cx.fillStyle='#fff';cx.beginPath();
  for(let i=0;i<10;i++){
    const a=Math.PI+i*Math.PI/5;
    const r=i%2===0?9:4;
    const x=Math.cos(a)*r,y=Math.sin(a)*r;
    if(i===0)cx.moveTo(x,y);else cx.lineTo(x,y);
  }
  cx.closePath();cx.fill();cx.restore();
  cx.restore();
  cx.restore();
  for(const it of items){
    cx.fillStyle=it.t=='ammo'?'#d9b24c':'#d2584f';
    cx.fillRect(it.x-8,it.y-8,16,16);
    cx.fillStyle='#111';cx.font='bold 11px sans-serif';cx.textAlign='center';
    cx.fillText(it.t=='ammo'?'M':'+',it.x,it.y+4);
  }
  for(const q of parts){cx.globalAlpha=Math.min(1,q.life*2);cx.fillStyle=q.col;cx.fillRect(q.x,q.y,3,3)}
  cx.globalAlpha=1;
  for(const z of zs){
    cx.fillStyle=z.hit>0?'#fff':z.big?'#3f5a34':z.fast?'#8aa04a':'#5f7d4e';
    cx.beginPath();cx.arc(z.x,z.y,z.r,0,6.28);cx.fill();
    // kollar
    const a=z.a||0;
    cx.strokeStyle=cx.fillStyle;cx.lineWidth=z.big?6:4;
    for(const s of[-1,1]){cx.beginPath();cx.moveTo(z.x,z.y);
      cx.lineTo(z.x+Math.cos(a+s*.5)*(z.r+9),z.y+Math.sin(a+s*.5)*(z.r+9));cx.stroke()}
    cx.fillStyle='#a22';cx.fillRect(z.x+Math.cos(a)*z.r*.4-2,z.y+Math.sin(a)*z.r*.4-2,4,4);
    if(z.hp<z.max){cx.fillStyle='#300';cx.fillRect(z.x-12,z.y-z.r-9,24,3);
      cx.fillStyle='#c33';cx.fillRect(z.x-12,z.y-z.r-9,24*z.hp/z.max,3)}
  }
  for(const b of bs){cx.fillStyle=b.renk||'#ffe9a0';cx.beginPath();cx.arc(b.x,b.y,b.boy||2.5,0,6.28);cx.fill()}
  for(const r of rings){const k=r.life/.3;cx.strokeStyle='rgba(255,170,60,'+k+')';cx.lineWidth=4;cx.beginPath();cx.arc(r.x,r.y,r.r*(1-k)+10,0,6.28);cx.stroke()}
  cx.textAlign='center';cx.font='bold 16px Georgia';
  for(const f of floats){cx.globalAlpha=Math.max(0,f.life);cx.fillStyle='#e6c75a';cx.fillText(f.t,f.x,f.y)}
  cx.globalAlpha=1;
  // oyuncu
  cx.save();cx.translate(p.x,p.y);cx.rotate(p.ang);
  cx.fillStyle='#3a4a5c';cx.beginPath();cx.arc(0,0,p.r,0,6.28);cx.fill();
  if(cw().melee){
    const sw=p.swing>0,t=sw?p.swing/.18:0,w=cw();
    if(sw){cx.strokeStyle='rgba(255,255,255,'+(t*.5)+')';cx.lineWidth=3;cx.beginPath();cx.arc(0,0,w.menzil,-w.arc/2,-w.arc/2+(1-t)*w.arc);cx.stroke()}
    cx.save();cx.rotate(sw?-w.arc/2+(1-t)*w.arc:-.6);
    cx.fillStyle='#6b4a2b';cx.fillRect(6,-2,34,4);
    cx.fillStyle='#b9c2c8';cx.fillRect(34,-11,9,14);
    cx.restore();
  }else{cx.fillStyle='#222';cx.fillRect(4,-3,22,6)}
  cx.fillStyle='#c9a27a';cx.beginPath();cx.arc(2,0,6,0,6.28);cx.fill();
  cx.restore();
  // karanlık ve el feneri
  const g=cx.createRadialGradient(p.x,p.y,40,p.x,p.y,420);
  g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(1,'rgba(0,0,0,.6)');
  cx.fillStyle=g;cx.fillRect(0,0,W,H);
  cx.restore();
  if(flash>0){
    const rg=cx.createRadialGradient(W/2,H/2,H*.25,W/2,H/2,W*.6);
    rg.addColorStop(0,'rgba(200,20,20,'+(flash*.5)+')');rg.addColorStop(1,'rgba(200,20,20,'+(flash*1.8)+')');
    cx.fillStyle=rg;cx.fillRect(0,0,W,H);
  }
  hud();
}
function hud(){
  cx.textAlign='left';cx.font='16px Georgia';cx.fillStyle='#d8e2d0';
  cx.fillText('Dalga '+wave+'  ('+Z.ad+')',16,26);
  cx.fillText('Skor '+score+'   Öldürülen '+kills,16,48);
  cx.fillStyle='#e6c75a';cx.fillText('Para $'+p.money,16,70);cx.fillStyle='#d8e2d0';
  const ak=[cheats.god&&'GOD',cheats.inf&&'MERMİ ∞',cheats.speed&&'HIZ'].filter(Boolean).join('   ');
  if(ak){cx.fillStyle='#e6c75a';cx.font='13px Georgia';cx.fillText(ak,16,90);cx.font='16px Georgia';cx.fillStyle='#d8e2d0'}
  // can
  cx.fillStyle='#311';cx.fillRect(16,H-34,200,12);
  cx.fillStyle='#c0443a';cx.fillRect(16,H-34,200*Math.max(0,p.hp)/100,12);
  cx.fillStyle='#223';cx.fillRect(16,H-18,200,6);
  cx.fillStyle='#5aa0d8';cx.fillRect(16,H-18,200*p.stam/100,6);
  cx.fillStyle='#d8e2d0';cx.textAlign='right';cx.font='20px Georgia';
  cx.fillText(cw().melee?'Yakın dövüş':cheats.inf?'∞':p.reload>0?'Dolduruluyor...':cs().ammo+' / '+cs().res,W-16,H-18);
  cx.font='15px Georgia';cx.fillText(cw().ad,W-16,H-46);
  if(spawnLeft<=0&&zs.length==0&&running){
    cx.textAlign='center';cx.font='28px Georgia';
    cx.fillText('Dalga '+(wave+1)+' geliyor... (B: dükkân)',W/2,80);
  }
}
function loop(t){
  if(!running)return;
  if(shopOpen||konOpen){lastT=t;requestAnimationFrame(loop);return}
  const dt=Math.min(.05,(t-lastT)/1000);lastT=t;
  update(dt);if(running)draw();
  requestAnimationFrame(loop);
}
function basla(){
  reset();shopOpen=false;shopEl.style.display='none';dk.style.display='block';kb.style.display='block';ov.style.display='none';running=true;lastT=performance.now();
  requestAnimationFrame(loop);
}
function bitti(){
  running=false;closeShop();closeKon();dk.style.display='none';kb.style.display='none';draw();
  ov.style.display='flex';
  ov.querySelector('h1').textContent='Hayatta kalamadın';
  sonuc.textContent=Z.ad+' zorlukta '+wave+'. dalgaya ulaştın, '+kills+' zombi öldürdün, skorun '+score+'.';
  btn.textContent='Tekrar dene';
}
const dk=document.getElementById('dk'),shopEl=document.getElementById('shop');
function cw(){return WEAPONS[p.g]}
function cs(){return p.guns[p.g]}
function sec(i){if(p.guns[i].own&&i!=p.g){p.g=i;p.reload=0;p.cd=.2}}
function kazan(z){p.money+=z.val;floats.push({x:z.x,y:z.y,t:'+$'+z.val,life:1})}
function mermiFiyat(){return Math.round(cw().fiyat*.1)+15}
function openShop(){if(!running)return;shopOpen=true;mouse.down=false;renderShop();shopEl.style.display='flex'}
function closeShop(){shopOpen=false;shopEl.style.display='none'}
const PAKET=100;
let shopTab='hepsi';
function renkKat(f){return f<100?'#8fa68a':f<300?'#5aa0d8':f<600?'#a77bd6':f<1000?'#e0953a':'#e0554a'}
function tus(i){return i<9?String(i+1):i==9?'0':''}
function istat(w){
  const dmg=w.patla?w.patdmg:w.dmg*Math.max(1,w.pel);
  const hz=1/w.cd;
  const mn=w.melee?w.menzil/120:(w.hiz*(w.omur||.9))/1000;
  return [['Hasar',Math.min(1,dmg/8)],['Hız',Math.min(1,hz/12)],['Menzil',Math.min(1,Math.max(.05,mn))]];
}
function dolas(d){
  const n=WEAPONS.length;let i=p.g;
  for(let k=0;k<n;k++){i=(i+d+n)%n;if(p.guns[i].own){sec(i);return}}
}
function patlat(b){
  rings.push({x:b.x,y:b.y,r:b.patla,life:.3});
  burst(b.x,b.y,40,'#f0a030');burst(b.x,b.y,16,'#ffe9a0');
  shake=12;beep(55,.3,'sawtooth',.09);
  for(const z of zs){
    if(z.hp<=0)continue;
    if(Math.hypot(z.x-b.x,z.y-b.y)<b.patla+z.r){
      z.hp-=b.patdmg;z.hit=.12;
      if(z.hp<=0)oldur(z);
    }
  }
}
function mkart(ad,tur,ack,fiyat,renk,btn){
  return '<div class="sh-kart" style="--renk:'+renk+'"><div class="sh-bas"><b>'+ad+'</b><em>'+tur+'</em></div><p>'+ack+'</p><div class="sh-alt2"><span class="sh-fiyat">$'+fiyat+'</span>'+btn+'</div></div>';
}
function renderShop(){
  const g=cs(),w=cw();
  let h='<div class="sh-ust"><h2>Silah Dükkânı</h2><div class="sh-para">$ '+p.money+'</div></div>';
  h+='<div class="sh-alt">Elinde: <b>'+w.ad+'</b>'+(w.melee?'':'  |  '+(cheats.inf?'∞':g.ammo)+' / '+g.res)+'</div>';
  const T=[['hepsi','Hepsi'],['yakin','Yakın dövüş'],['ates','Ateşli'],['malzeme','Malzeme']];
  h+='<div class="sh-tab">'+T.map(t=>'<button data-a="tab" data-t="'+t[0]+'" class="'+(shopTab==t[0]?'on':'')+'">'+t[1]+'</button>').join('')+'</div>';
  h+='<div class="sh-grid">';
  if(shopTab!='malzeme'){
    WEAPONS.forEach((x,i)=>{
      if(shopTab=='yakin'&&!x.melee)return;
      if(shopTab=='ates'&&x.melee)return;
      const s=p.guns[i],renk=renkKat(x.fiyat),eld=p.g==i,yok=!s.own&&p.money<x.fiyat;
      const tur=x.melee?'Yakın dövüş':x.patla?'Patlayıcı':'Ateşli';
      let d;
      if(eld)d='<span class="sh-el">Elinde</span>';
      else if(s.own)d='<button data-a="sec" data-i="'+i+'">Seç'+(tus(i)?' ('+tus(i)+')':'')+'</button>';
      else d='<button data-a="al" data-i="'+i+'"'+(yok?' disabled':'')+'>Satın al</button>';
      const bars=istat(x).map(b=>'<div class="sh-bar"><span>'+b[0]+'</span><i><b style="width:'+Math.round(b[1]*100)+'%;background:'+renk+'"></b></i></div>').join('');
      h+='<div class="sh-kart'+(eld?' eld':'')+(yok?' soluk':'')+'" style="--renk:'+renk+'"><div class="sh-bas"><b>'+x.ad+'</b><em>'+tur+'</em></div><p>'+x.ack+'</p>'+bars+'<div class="sh-alt2"><span class="sh-fiyat">'+(x.fiyat?'$'+x.fiyat:'Ücretsiz')+'</span>'+d+'</div>'+(s.own&&!x.melee?'<small>Yedek mermi: '+s.res+'</small>':'')+'</div>';
    });
  }else{
    const f=mermiFiyat(),mel=w.melee;
    h+=mkart('Cephane','Malzeme',mel?'Elindeki silah cephane kullanmaz.':w.ad+' için bir şarjör.',f,'#d9b24c','<button data-a="mermi"'+(p.money<f||mel?' disabled':'')+'>Satın al</button>');
    h+=mkart('Cephane paketi','Malzeme','Sahip olduğun tüm ateşli silahlara bir şarjör.',PAKET,'#d9b24c','<button data-a="paket"'+(p.money<PAKET?' disabled':'')+'>Satın al</button>');
    h+=mkart('İlk yardım','Malzeme','+50 can.',60,'#d2584f','<button data-a="can"'+(p.money<60||p.hp>=100?' disabled':'')+'>Satın al</button>');
  }
  h+='</div><button data-a="kapat" class="sh-kapat">Oyuna dön (B)</button>';
  shopEl.innerHTML=h;
}
shopEl.addEventListener('click',e=>{
  const b=e.target.closest('button');if(!b||b.disabled)return;
  const a=b.dataset.a,i=+b.dataset.i;
  if(a=='kapat'){closeShop();return}
  if(a=='tab')shopTab=b.dataset.t;
  else if(a=='al'){const w=WEAPONS[i];if(p.money>=w.fiyat){p.money-=w.fiyat;const s=p.guns[i];s.own=true;s.ammo=w.mag;s.res=w.mag*3;sec(i)}}
  else if(a=='sec')sec(i);
  else if(a=='mermi'){const f=mermiFiyat();if(p.money>=f&&!cw().melee){p.money-=f;cs().res+=cw().mag}}
  else if(a=='paket'){if(p.money>=PAKET){p.money-=PAKET;WEAPONS.forEach((x,j)=>{if(p.guns[j].own&&!x.melee)p.guns[j].res+=x.mag})}}
  else if(a=='can'){if(p.money>=60&&p.hp<100){p.money-=60;p.hp=Math.min(100,p.hp+50)}}
  renderShop();
});
const zorEl=document.getElementById('zor'),zacik=document.getElementById('zacik');
function zorluguCiz(){
  zorEl.innerHTML=Object.keys(ZORLUK).map(k=>'<button class="zb'+(ZORLUK[k]===Z?' on':'')+'" data-z="'+k+'">'+ZORLUK[k].ad+'</button>').join('');
  zacik.textContent=Z.acik;
}
zorEl.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;Z=ZORLUK[b.dataset.z];zorluguCiz()});
zorluguCiz();
cv.addEventListener('wheel',e=>{e.preventDefault();if(running&&!shopOpen&&!konOpen)dolas(e.deltaY>0?1:-1)},{passive:false});
dk.onclick=()=>{shopOpen?closeShop():openShop();dk.blur()};
const cheats={god:false,inf:false,speed:false};
const kb=document.getElementById('kb'),konEl=document.getElementById('kon'),konLog=document.getElementById('konlog'),konIn=document.getElementById('konin');
function konYaz(t,c){const d=document.createElement('div');d.textContent=t;if(c)d.style.color=c;konLog.appendChild(d);while(konLog.children.length>8)konLog.removeChild(konLog.firstChild)}
function openKon(){if(!running)return;konOpen=true;mouse.down=false;keys={};konEl.style.display='block';konIn.value='';konIn.focus()}
function closeKon(){konOpen=false;mouse.down=false;konEl.style.display='none';konIn.blur()}
function oldur(z){kills++;score+=z.big?50:10;kazan(z);burst(z.x,z.y,14,'#5a1010');if(Math.random()<Z.drop)items.push({x:z.x,y:z.y,t:Math.random()<.5?'ammo':'med',life:12})}
function ammoVer(){
  let i=p.g;
  if(cw().melee){const c=WEAPONS.map((w,j)=>j).filter(j=>p.guns[j].own&&!WEAPONS[j].melee);i=c[Math.floor(Math.random()*c.length)]}
  p.guns[i].res+=WEAPONS[i].mag;
}
function vur(w){
  p.cd=w.cd;p.swing=.18;shake=2;beep(w.ses,.08,'sawtooth',.05);
  for(const z of zs){
    if(z.hp<=0)continue;
    const dx=z.x-p.x,dy=z.y-p.y,d=Math.hypot(dx,dy);
    if(d>w.menzil+z.r)continue;
    let da=Math.atan2(dy,dx)-p.ang;da=Math.atan2(Math.sin(da),Math.cos(da));
    if(Math.abs(da)>w.arc/2&&d>p.r+z.r)continue;
    z.hp-=w.dmg;z.hit=.12;burst(z.x,z.y,6,'#7a1f1f');
    z.x+=dx/(d||1)*28;z.y+=dy/(d||1)*28;
    if(z.hp<=0)oldur(z);
  }
}
function komut(raw){
  const t=raw.trim().toLowerCase();if(!t)return;
  const pr=t.split(/\s+/),c=pr[0],n=parseInt(pr[1]);
  const yeşil='#b8d86b';
  konYaz('> '+t,'#9fb092');
  const durum=(v,ad)=>konYaz(ad+': '+(v?'açık':'kapalı'),yeşil);
  switch(c){
    case 'god':case 'tanri':cheats.god=!cheats.god;durum(cheats.god,'God modu');break;
    case 'infiniteammo':case 'sonsuzmermi':cheats.inf=!cheats.inf;durum(cheats.inf,'Sonsuz mermi');break;
    case 'speed':case 'hiz':cheats.speed=!cheats.speed;durum(cheats.speed,'Hız');break;
    case 'money':case 'para':p.money+=isNaN(n)?1000:n;konYaz('Para: $'+p.money,yeşil);break;
    case 'heal':case 'can':p.hp=100;p.stam=100;konYaz('Can ve dayanıklılık doldu',yeşil);break;
    case 'giveall':case 'tumsilahlar':
      WEAPONS.forEach((w,i)=>{const g=p.guns[i];if(!g.own){g.own=true;g.ammo=w.mag;g.res=w.mag*3}});
      konYaz('Tüm silahlar verildi',yeşil);break;
    case 'killall':case 'oldur':
      zs.forEach(z=>{if(z.hp>0){z.hp=0;oldur(z)}});zs=[];spawnLeft=0;konYaz('Tüm zombiler öldürüldü',yeşil);break;
    case 'wave':case 'dalga':
      if(isNaN(n)||n<1){konYaz('Kullanım: wave 5','#d2584f');break}
      wave=n-1;zs=[];spawnLeft=0;waveBreak=.5;konYaz('Dalga '+n+' başlıyor',yeşil);break;
    case 'spawn':case 'zombi':{
      const k=Math.min(isNaN(n)?5:n,50);for(let i=0;i<k;i++)spawnZ();konYaz(k+' zombi eklendi',yeşil);break}
    case 'help':case 'yardim':
      konYaz('god, infiniteammo, speed, money [n], heal, giveall, killall, wave [n], spawn [n]');
      konYaz('Türkçe: tanri, sonsuzmermi, hiz, para, can, tumsilahlar, oldur, dalga, zombi');
      konYaz('Esc ile konsolu kapat');break;
    default:konYaz('Bilinmeyen komut. "help" yaz.','#d2584f');
  }
  draw();
}
konIn.addEventListener('keydown',e=>{if(e.key=='Enter'){komut(konIn.value);konIn.value=''}});
kb.onclick=()=>{konOpen?closeKon():openKon();kb.blur()};
konYaz('Komut konsolu. "help" yaz.','#9fb092');
btn.onclick=basla;
addEventListener('keydown',e=>{const k=e.key.toLowerCase();
  if(konOpen){if(k=='escape')closeKon();return}
  if(running&&!shopOpen&&!e.repeat&&(k=='t'||k=='f2')){e.preventDefault();openKon();return}
  keys[k]=true;
  if(k=='r'&&running&&!shopOpen)startReload();
  if(running&&!e.repeat&&(k=='b'||(k=='escape'&&shopOpen)))shopOpen?closeShop():openShop();
  if(running&&!shopOpen&&'1234567890'.includes(k)&&k.length==1)sec(k=='0'?9:+k-1);
  if(running&&!shopOpen&&(k=='q'||k=='e'))dolas(k=='e'?1:-1);
  if(['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k))e.preventDefault();});
addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);
function pos(e){const r=cv.getBoundingClientRect();
  mouse.x=(e.clientX-r.left)*W/r.width;mouse.y=(e.clientY-r.top)*H/r.height}
cv.addEventListener('mousemove',pos);
cv.addEventListener('mousedown',e=>{pos(e);mouse.down=true});
addEventListener('mouseup',()=>mouse.down=false);
cv.addEventListener('touchstart',e=>{e.preventDefault();pos(e.touches[0]);mouse.down=true},{passive:false});
cv.addEventListener('touchmove',e=>{e.preventDefault();pos(e.touches[0])},{passive:false});
cv.addEventListener('touchend',()=>mouse.down=false);
reset();draw();
</script>
</body>
</html>
